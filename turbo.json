{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["generated/**", "src/pothos-types.ts"]
    },
    "codegen": {
      "dependsOn": ["@gqlkit/schema#build"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "@gqlkit/client#build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "@gqlkit/client#typecheck": {
      "dependsOn": ["^build", "codegen"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:recipes": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {},
    "format:check": {}
  }
}
